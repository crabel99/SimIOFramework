{
  "name": "Crypto",
  "version": "0.1.0",
  "description": "Arduino-facing cryptography API layered over Mbed TLS and SAME5x crypto hardware modules.",
  "keywords": [
    "crypto",
    "aes",
    "trng",
    "pukcc",
    "mbedtls"
  ],
  "frameworks": [
    "arduino"
  ],
  "platforms": [
    "atmelsam",
    "native"
  ],
  "build": {
    "flags": [
      "-DMBEDTLS_CONFIG_FILE=\\\"utility/mbedtls/TlsConfig.h\\\"",
      "-DTF_PSA_CRYPTO_CONFIG_FILE=\\\"utility/mbedtls/TlsConfig.h\\\"",
      "-Isrc/utility/third_party/mbedtls/include",
      "-Isrc/utility/third_party/mbedtls/library",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/include",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/core",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/dispatch",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/include",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/extras",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/platform",
      "-Isrc/utility/third_party/mbedtls/tf-psa-crypto/utilities"
    ],
    "srcFilter": [
      "+<*>",
      "-<utility/third_party/>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/aes.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/bignum.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/bignum_core.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/bignum_mod.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/bignum_mod_raw.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/block_cipher.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/cipher.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/cipher_wrap.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/ctr_drbg.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/ecdsa.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/ecp.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/ecp_curves.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/ecp_curves_new.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/gcm.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/psa_crypto_aead.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/psa_crypto_cipher.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/psa_crypto_ecp.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/psa_crypto_hash.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/psa_crypto_mac.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/psa_crypto_rsa.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/psa_util_internal.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/sha256.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/drivers/builtin/src/sha512.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/core/psa_crypto.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/core/psa_crypto_client.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/core/psa_crypto_random.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/core/psa_crypto_slot_management.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/core/psa_crypto_storage.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/core/psa_its_file.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/core/psa_util.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/dispatch/psa_crypto_driver_wrappers_no_static.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/extras/md.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/extras/pk.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/extras/pk_ecc.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/extras/pk_wrap.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/extras/pkparse.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/utilities/asn1parse.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/utilities/asn1write.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/utilities/base64.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/utilities/constant_time.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/utilities/oid.c>",
      "+<utility/third_party/mbedtls/tf-psa-crypto/utilities/pem.c>",
      "+<utility/third_party/mbedtls/library/debug.c>",
      "+<utility/third_party/mbedtls/library/ssl_ciphersuites.c>",
      "+<utility/third_party/mbedtls/library/ssl_client.c>",
      "+<utility/third_party/mbedtls/library/ssl_msg.c>",
      "+<utility/third_party/mbedtls/library/ssl_tls.c>",
      "+<utility/third_party/mbedtls/library/ssl_tls12_client.c>",
      "+<utility/third_party/mbedtls/library/x509.c>",
      "+<utility/third_party/mbedtls/library/x509_crt.c>",
      "+<utility/third_party/mbedtls/library/x509_oid.c>"
    ]
  }
}
